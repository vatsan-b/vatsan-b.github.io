# Quarto's render cache (rebuilt on every render). docs/ is NOT ignored:
# it is the published site and must be committed.
/.quarto/
**/*.quarto_ipynb

# Local scratch space and backup copies of the render output
/temp/
*.bak/

# Windows download markers created when copying files from Windows into WSL
*:Zone.Identifier
*.Zone.Identifier

# Python and editor leftovers
__pycache__/
*.py[cod]
.venv/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Secrets must never be committed
.env
.env.*
*.key
*.pem
